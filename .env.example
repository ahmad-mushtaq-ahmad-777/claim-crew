# Copy to .env.local (never commit real keys). On Vercel, set these as Environment Variables.
MOCK_LLM=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: comma-separated backup models tried automatically if the main one is overloaded
LLM_FALLBACK_MODELS=

# Dispatcher email (Gmail app password, never commit real values)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Fixed "To" address that plays the role of the Accounts department
ACCOUNTS_EMAIL=
